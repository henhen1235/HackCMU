# EchoArena — copy to .env and fill in your key
XAI_API_KEY=xai-your-key-here
XAI_BASE_URL=https://api.x.ai/v1
# Fastest for real-time control (no chain-of-thought). Alternatives:
#   grok-4.6                 (smarter; client forces reasoning_effort=low)
#   grok-4.20-0309-reasoning (slower thinking)
#   grok-4.3                 (mid)
XAI_MODEL=grok-4.20-0309-non-reasoning
